static void SLEmpiricalTest(double period, double wavenumber, double angle, std::vector<double> sinVector, std::vector<double> cosVector, double pertSize, int decay, int DoF, int overKillDoF, int trainingSamples, int testingSamples, int RB, int numOfRealizations)
{
    unsigned greenTerms = 2;
    UQProblemFactory testingFactory(period, angle, wavenumber, pertSize, decay, overKillDoF, std::vector<double>{sinVector}, std::vector<double>{cosVector}, greenTerms);
    std::vector<std::shared_ptr<UQProblemFactoryReduced>> uqVector;
    
    TrigonometricCurve nominalCurve(period, 0, sinVector, cosVector);
    PECGrating nominalGrating(new TrigonometricCurve(nominalCurve), angle, wavenumber, overKillDoF, greenTerms);
    nominalGrating.buildDiscrete();
    nominalGrating.solve();
    auto &nominalMatrix = nominalGrating.getMatrix();
    std::cout << std::abs((nominalMatrix*nominalGrating.getSolutionVec()).dot(nominalGrating.getSolutionVec())) << std::endl;
    RegularP0_1D fine(nominalCurve, overKillDoF);
    RegularP0_1D coarse(nominalCurve, DoF);
    auto &matrixMgr = DiscreteSpaceMatrixMgr_1D::get();
    auto LHFC = matrixMgr.getData(coarse, fine).transpose();
    auto RHFC = matrixMgr.getData(coarse, fine);
    auto LHFCP = matrixMgr.getData(fine, coarse);

    progressbar barR(numOfRealizations);
    for (int i = 0; i < numOfRealizations; ++i) {
        barR.update();
        uqVector.emplace_back(new UQProblemFactoryReduced(period, angle, wavenumber, pertSize, decay, DoF, std::vector<double>{sinVector}, std::vector<double>{cosVector}, greenTerms));
        uqVector.back()->trainEmpirical(trainingSamples, (1./RB));
    }

    std::vector<double> _solutionError(numOfRealizations, 0.0);
    std::vector<double> _matrixError(numOfRealizations, 0.0);
    
    int envBatch = BEM::getEnv<int>("TEST_BATCH_SIZE");
    int batchSize = envBatch > 0 ? envBatch : 10;
    int numBatches = std::ceil(testingSamples/batchSize);
    progressbar bar(batchSize*numBatches);
    int counter = 0;
    
    for (int batch = 0; batch < numBatches; ++batch) {
        std::vector<double> errorVec(batchSize, 0);
        std::vector<double> normVec(batchSize, 0);
        std::vector<std::unique_ptr<Problem>> batchSet;
        std::vector<std::vector<BEM::ColVector>> solutionDiffVector(numOfRealizations, std::vector<BEM::ColVector>());
        std::vector<std::vector<BEM::Matrix>> matrixDiffVector(numOfRealizations, std::vector<BEM::Matrix>());
        for (int i = 0; i < batchSize; ++i) {
            bar.update();
            auto testProb = testingFactory.RandomProblemFactory::generateNewTestingProblem();
            auto PECProb = static_cast<PECGrating*>(testProb.get());
            const Curve2D& curve = PECProb->getCurve();
            PECProb->buildDiscrete();
            PECProb->solve();
            for (int realization = 0; realization < numOfRealizations; ++realization) {
                auto &uq = uqVector[realization];
                auto iProb = uq->generateProblemFromCurve(new TrigonometricCurve(static_cast<const TrigonometricCurve &>(curve)));
                auto trueRHS = iProb->getRHS();
                auto interpolation = iProb->interpolatedMatrix();
                matrixDiffVector[realization].push_back(BEM::product(BEM::product(LHFC,interpolation), RHFC) - PECProb->interpolatedMatrix());
                BEM::ColVector solutionVector(interpolation.colPivHouseholderQr().solve(trueRHS));
                auto solutionFunction = coarse.DiscreteSpace_1D::generateFunction(solutionVector);
                BEM::plotFunction("sol"+std::to_string(counter++), *solutionFunction);
                solutionDiffVector[realization].push_back(LHFCP*solutionVector - PECProb->getSolutionVec());
            }
        }
        
        for (int realization = 0; realization < numOfRealizations; ++realization) {
            std::vector<double> localMatrixError(batchSize, 0.0);
            std::vector<double> localSolutionError(batchSize, 0.0);
            tbb::parallel_for(tbb::blocked_range<int>(0, batchSize), [&](const tbb::blocked_range<int> &r) {
                for (int i = r.begin(); i!=r.end(); ++i) {
                    localMatrixError[i] += matrixDiffVector[realization][i].operatorNorm()/testingSamples;
                    localSolutionError[i] += std::abs((nominalMatrix*solutionDiffVector[realization][i]).dot(solutionDiffVector[realization][i]))/testingSamples;
                }
            });
            _matrixError[realization] += std::accumulate(localMatrixError.begin(), localMatrixError.end(), 0.0);
            _solutionError[realization] += std::accumulate(localSolutionError.begin(), localSolutionError.end(), 0.0);
        }
    }
    
    std::cout << "======" << std::endl;
    std::cout << "Matrix Error: ";
    std::cout << "[" << std::sqrt(_matrixError[0]);
    for (int i = 1; i < numOfRealizations; ++i) {
        std::cout << ", " << std::sqrt(_matrixError[i]);
    }
    std::cout << "]" << std::endl;

    std::cout << "Solution Error: ";
    std::cout << "[" << std::sqrt(_solutionError[0]);
    for (int i = 1; i < numOfRealizations; ++i) {
        std::cout << ", " << std::sqrt(_solutionError[i]);
    }
    std::cout << "]" << std::endl;    
    std::cout << "DoF: " << DoF << std::endl;
    std::cout << "Work: " << trainingSamples*DoF*DoF << std::endl;
    
}

int main(int argc, char* argv[]) {
    po::options_description desc("Options");
    desc.add_options()("Problem", po::value<int>(), "Specify problem to solve")
        ("help", "Show help menu")
        ("P", po::value<double>(), "Period")
        ("WL", po::value<double>(), "Wavelength")
        ("WN", po::value<double>(), "Wavenumber")
        ("ANG", po::value<double>(), "Angle")
        ("DOF", po::value<int>(), "NumOfElements")
        ("OK", po::value<int>(), "NumOfElements for Overkill")
        ("SIN", po::value<std::vector<double>>()->multitoken(), "SinCoef")
        ("COS", po::value<std::vector<double>>()->multitoken(), "CosCoef")
        ("DCY", po::value<double>(), "Decay")
        ("PS", po::value<double>(), "Perturbation size")
        ("TG", po::value<int>(), "TrainingSamples")
        ("TT", po::value<int>(), "TestingSamples")
        ("RL", po::value<int>(), "Realizations")
        ("RBG", po::value<int>(), "RBGreen");
    
    po::variables_map vm;
    po::store(po::parse_command_line(argc, argv, desc), vm);
    po::notify(vm);
    if (vm.count("help")) {
        std::cout << desc << std::endl;
        return 1;
    }
    
    if (vm.count("P")) {
        if (vm["Problem"].as<int>() == 1){
            runAndPlotSolutionForHolo(vm["P"].as<double>(), vm.count("WL") ? 2.*M_PI/vm["WL"].as<double>() : vm["WN"].as<double>(),  vm["ANG"].as<double>(), vm["DOF"].as<int>(), vm["SIN"].as<std::vector<double>>(), vm["COS"].as<std::vector<double>>());
            return 0;
        }

        if (vm["Problem"].as<int>() == 2) {
            SLEmpiricalTest(vm["P"].as<double>(), vm.count("WL") ? 2.*M_PI/vm["WL"].as<double>() : vm["WN"].as<double>(),  vm["ANG"].as<double>(), vm["SIN"].as<std::vector<double>>(), vm["COS"].as<std::vector<double>>(), vm["PS"].as<double>(), vm["DCY"].as<double>(), vm["DOF"].as<int>(), vm["OK"].as<int>(), vm["TG"].as<int>(), vm["TT"].as<int>(), vm["RBG"].as<int>(), vm["RL"].as<int>());
        }

        if (vm["Problem"].as<int>() == 3) {
            Reliability(vm["P"].as<double>(), vm.count("WL") ? 2.*M_PI/vm["WL"].as<double>() : vm["WN"].as<double>(),  vm["ANG"].as<double>(), vm["SIN"].as<std::vector<double>>(), vm["COS"].as<std::vector<double>>(), vm["PS"].as<double>(), vm["DCY"].as<double>(), vm["DOF"].as<int>(), vm["TG"].as<int>(), vm["RBG"].as<int>());
        }
        
    }
    return 0;
}
