static void runAndPlotSolutionForHolo(double period, double wavenumber, double angle, int N, std::vector<double> sinVector, std::vector<double> cosVector) {

    std::cout << "Wavenumber: " << wavenumber << std::endl;
    std::cout << "Period: " << period << std::endl;
    std::cout << "Wavelength/Period: " << 2.*M_PI/(wavenumber*period) << std::endl;
    std::cout << "Angle: " << angle/M_PI <<  " x PI"  << std::endl;
    TrigonometricCurve curve(period, 0., (sinVector), (cosVector));
    std::cout << cosVector[0] << std::endl;
    PECGrating prob(new TrigonometricCurve(period, 0., (sinVector), (cosVector)), angle, wavenumber, N, 50);
    auto start = std::chrono::system_clock::now();
    prob.buildDiscrete();
    auto end = std::chrono::system_clock::now();
    auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
    std::cout << elapsed.count() << "[ms]" << std::endl;
    prob.solve();
    std::cout << prob.efficiency(0) << std::endl;
    auto sol = prob.getSpace().generateFunction(prob.getSolutionVec());
    BEM::plotFunction("solution", *sol);
    // prob.plotSolution("Solution_P" +std::to_string(period) + "_k" + std::to_string(wavenumber) + "_ang" +std::to_string(angle) + "_N" + std::to_string(N) + ".txt");
}

