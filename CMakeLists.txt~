cmake_minimum_required(VERSION 3.20)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set(CMAKE_CXX_FLAGS "-Wall -Wextra  -Xpreprocessor -O3 -pedantic")

find_package(Python3 COMPONENTS Interpreter Development REQUIRED)

project(hallo VERSION 1.0)
file(GLOB_RECURSE SRC_FILES src/*.cc)

find_package(Boost 1.84 COMPONENTS program_options REQUIRED)
find_package(TBB REQUIRED)
add_executable(BEM BEM.cc ${SRC_FILES})
target_include_directories(BEM PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/includes ~/eigen /opt/homebrew/Cellar/python@3.12/3.12.4/Frameworks/Python.framework/Headers /opt/homebrew/Cellar/numpy/2.1.0/lib/python3.12/site-packages/numpy/_core/include)
target_link_libraries(BEM Boost::program_options TBB::tbb Python3::Python Python3::Module)
